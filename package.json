{
  "name": "catalog-sync",
  "version": "1.0.0",
  "description": "Bulk product import for WooCommerce: CSV in, validated, split into chunks and synced by parallel workers with live progress",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:mock": "tsx src/mock/wooServer.ts",
    "import": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:mock": "node dist/mock/wooServer.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sample": "tsx scripts/generate-sample.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
